# Windows shell scripts require CRLF for cmd.exe label parsing
# (LF-only .bat files break `goto label` at runtime).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.sh text eol=lf
.github/workflows/*.yml text eol=lf

# Preserve the original Snow Skin asset line endings for byte-exact bundling.
assets/inject/upstream/snow-skin/*.js text eol=lf
assets/inject/upstream/snow-skin/*.css text eol=lf

# Preserve CRLF bytes from the remaining vendored theme text assets.
assets/inject/upstream/dream-skin/**/*.js -text whitespace=cr-at-eol
assets/inject/upstream/dream-skin/**/*.css -text whitespace=cr-at-eol
assets/inject/upstream/cidala-tiger/**/*.js -text whitespace=cr-at-eol
assets/inject/upstream/cidala-tiger/**/*.css -text whitespace=cr-at-eol
assets/inject/upstream/glass-vision/*.js -text whitespace=cr-at-eol
assets/inject/upstream/glass-vision/*.css -text whitespace=cr-at-eol
assets/inject/upstream/skin-packs/packs/**/theme.json -text whitespace=cr-at-eol
